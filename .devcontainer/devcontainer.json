// Devcontainer for talos-gitops-rehearsal. Reopens ADR-0003's "no devcontainer for
// v1" per ADR-0006: the concrete cross-machine reproducibility need it named as
// its revisit trigger (running the toolchain on a second host - the VPS) now
// exists. The image is self-contained (see Dockerfile); this file picks the
// service, lands as non-root `dev`, and wires the mise tools + lefthook gate.
{
  "name": "talos-gitops-rehearsal-dev",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/talos-gitops-rehearsal",
  "remoteUser": "dev",

  // Install the project's mise tools and set up the repo's lefthook gate.
  //
  // `bash -lc` is a login but NON-INTERACTIVE shell, so the mise activation line
  // in ~/.bashrc never runs here. Everything below therefore reaches mise by
  // explicit path, and reaches mise-managed tools via `mise exec` - a bare
  // `lefthook` would not resolve.
  "postCreateCommand": "bash -lc 'set -e; eval \"$(~/.local/bin/mise activate bash --shims)\"; mise trust --yes || true; mise install; mise exec -- lefthook install'",

  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
