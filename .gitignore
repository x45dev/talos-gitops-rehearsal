# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# Claude Code local cache
**/.claude/.enforce-cache.json

# Secrets (AGE/SOPS private keys - never commit plaintext key material)
.config/sops/age/keys.txt
.config/mise/.env.yaml

# Machine-local env files. Under the public-repo posture this repository carries no
# committed secret ciphertext either, so the encrypted file is untracked as well.
# Expected keys are documented in .config/mise/.env.yaml.template (secrets) and
# .config/mise/.env.local.template (non-secret overrides).
.config/mise/.env.sops.yaml
.config/mise/.env.local

# Host-specific devcontainer env (seeded from .env.example by initialize.sh; never committed)
.devcontainer/.env

# Runtime kubeconfig/talosconfig for the ephemeral local cluster (KUBECONFIG_WORK/
# TALOSCONFIG in .config/mise/config.toml [env]) - created by test-talos-spike:provision,
# removed by test-talos-spike:teardown; never committed.
.kube-workload.config
.talosconfig
