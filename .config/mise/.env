# FILE: .config/mise/.env
#
# DESCRIPTION:
# This file is for project-specific, NON-SENSITIVE environment variables that
# are loaded automatically by Mise. It is safe to commit this file to Git.
#
# IMPORTANT: Do NOT store secrets here - this file is committed to Git.
# SOPS_AGE_KEY_FILE is intentionally NOT set here; the project key path is
# configured via sops.age_key_file in mise/config.toml [settings].

# --- General ---
LOG_LEVEL="debug"

# --- K8s ---
# NB: {{config_root}}-relative path vars (KUBECONFIG_WORK, TALOSCONFIG) live in
# config.toml's [env] table, not here - this file is loaded as plain dotenv, so mise
# does not template {{config_root}} in it.
CLUSTER_NAME = "talos-cilium-test"

# --- Phase 3 turnkey payload (Cloudflare Tunnel / Dex) ---
# The account/zone IDs are redacted in the public tree: they are account-identifying
# rather than secret, and publishing them buys nothing.
# They remain retrievable from this repository's private history, which is an accepted,
# name-level residual risk (they identify an account; they do not authenticate to it).
# The real values live in the untracked .config/mise/.env.local and override the
# placeholders below, because mise loads that file after this one.
# To populate your own, look them up in the Cloudflare dashboard (Overview pane) or via
# the Cloudflare API, then write them into .env.local (seed it from .env.local.template).
# Credentials do not belong there: those go in the gitignored, encrypted .env.sops.yaml
# via `mise run project-secrets`.
IDP_DOMAIN = "idp.x45.dev"
CLOUDFLARE_TUNNEL_NAME = "kind-talos-idp"
CLOUDFLARE_ACCOUNT_ID = "<your-cloudflare-account-id>"
CLOUDFLARE_ZONE_ID = "<your-cloudflare-zone-id>"
