# FILE: .config/mise/.env.yaml.template
#
# DESCRIPTION:
# This is a template for the project's encrypted secrets.
# Use the `mise run sops:project:manage` (alias `project-secrets`) command to populate and encrypt this file.
#
# NB! You **must** add your AGE public key to .config/sops/config.yaml to ensure that
# this file is encrypted with a public key corresponding to your own private key!
#
# The encrypted output will be `.config/mise/.env.sops.yaml`, which is automatically
# loaded by Mise.
#
APP_ENV: development
API_KEY: "replace-me-with-a-real-api-key"
# Flux's read-only SSH deploy key (private half) for this repo, registered via
# `gh repo deploy-key add` (see `gh repo deploy-key list` for the registered key).
# Injected into the cluster's flux-system/git-credentials secret at bootstrap time by
# `test-talos-spike:flux-bootstrap` - never written to disk in plaintext.
# Persistent, not rotated per cluster cycle (Phase 2 decision - see the plan).
FLUX_GIT_DEPLOY_KEY: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  replace-me-with-a-real-deploy-key-generated-via-ssh-keygen
  -----END OPENSSH PRIVATE KEY-----

# Cloudflare API token (Zone:DNS:Edit + Account:Cloudflare Tunnel:Edit, scoped to the
# idp.x45.dev zone). Used by the imperative tunnel-bootstrap step (Phase 3) to create the
# Cloudflare Tunnel and DNS record via API - never written to disk in plaintext.
CLOUDFLARE_API_TOKEN: "replace-me-with-a-real-cloudflare-api-token"

# GitHub OAuth App backing Dex's GitHub connector (Phase 3). Registered at
# github.com/settings/developers with callback https://idp.x45.dev/callback.
# Client ID is not strictly secret but kept alongside the secret for one rotation unit.
GITHUB_OAUTH_CLIENT_ID: "replace-me-with-a-real-github-oauth-client-id"
GITHUB_OAUTH_CLIENT_SECRET: "replace-me-with-a-real-github-oauth-client-secret"

# EXAMPLE METADATA (AFTER ENCRYPTION):
# # This section is auto-generated by SOPS and should not be edited manually.
# # It contains metadata about the encryption keys used and the last modified timestamp.
#
# sops:
#     # Metadata will be populated by sops on first encryption
#     # Example structure (DO NOT EDIT MANUALLY):
#     kms: []
#     gcp_kms: []
#     azure_kv: []
#     hc_vault: []
#     age:
#         - recipient: age1... # Public key from .sops.yaml / keys.txt (AGE keyfile)
#           encrypted_regex: ^(data|stringData)$
#     lastmodified: "2024-01-01T10:00:00Z"
#     mac: ENC[...]
#     pgp: []
#     unencrypted_suffix: _unencrypted
#     version: 3.8.1 # Example